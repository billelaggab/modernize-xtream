# Copy to .env for local development and replace placeholders with your own secrets.
DATABASE_URL=postgresql://madar:YOUR_DATABASE_PASSWORD@127.0.0.1:5432/madar
# Optional for local agent testing; required for streaming in production.
AGENT_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_24_CHARACTERS
# Optional locally; required by the Docker Compose deployment.
SETUP_KEY=REPLACE_WITH_A_RANDOM_SETUP_KEY
